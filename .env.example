# Copy to `.env` and fill in. The TUI reads this from the repo root; docker
# compose reads the same file for the webhook + tunnel.

# ── Required ────────────────────────────────────────────────────────────────
# Entra application (client) ID of your registered public client.
M365_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ── Auth (optional) ─────────────────────────────────────────────────────────
# Tenant: your directory (GUID) or `organizations` (work/school) or `common`.
M365_TENANT_ID=organizations
# Space-separated scopes. Leave unset to use the sensible defaults in the code.
# F6 diagnostics compares this requested set with the scopes actually
# present in the cached access token; no secret token bytes are displayed.
# M365_SCOPES=openid profile offline_access User.Read Mail.ReadWrite Mail.Send Calendars.ReadWrite Chat.ReadWrite ChannelMessage.Read.All ChannelMessage.Send Presence.Read.All People.Read

# Where the encrypted-at-0600 token cache lives (defaults to the OS config dir).
# M365_TOKEN_CACHE=/home/you/.config/m365-tui/token-cache.json

# Talk to something other than the real Graph. Only useful for testing against a
# mock; leave unset for normal use.
# M365_GRAPH_BASE=http://127.0.0.1:8765/v1.0

# Desktop notifications for direct messages and @mentions (on by default).
# Group chats stay silent unless you're mentioned. Set to 0 to disable.
# M365_NOTIFY=0

# Teams Workflows can use "Post as User". In that mode Graph reports the
# signed-in AAD account as the sender and provides no application identity.
#
# List one-to-one peer IDs here when those chats are dedicated automation
# destinations. Values may be separated by commas or whitespace.
#
# Select a one-to-one chat and press F7:
#   i = copy peer ID and log ready-to-use .env/export lines
#   a = copy/log and offer to add the peer to the loaded .env after confirmation
#
# M365_TEAMS_AUTOMATION_PEERS=peer-id-from-F7
#
# Incoming Teams messages from real applications/bots (Graph from.application)
# and messages from configured automation peers can optionally use higher
# notification priority. Normal notification eligibility still applies.
#
# Desktop: critical urgency
# ntfy: priority 4 (high)
#
# M365_TEAMS_APPLICATION_HIGH_PRIORITY=1

# Optional ntfy forwarding. Default: never.
# Modes:
#   never    = disabled
#   always   = forward every eligible notification
#   away     = only while Graph availability is exactly Away
#   alwayswd = only inside the current Microsoft 365 Work Plan occurrence
#   awaywd   = both Away and inside the current Work Plan occurrence
# M365_NTFY=never
# M365_NTFY_SERVER=https://ntfy.example.com
# M365_NTFY_TOPIC=m365
# Optional Bearer token for a protected topic.
# M365_NTFY_TOKEN=
#
# M365_NOTIFY controls desktop notifications only.
# Set M365_NTFY=never to disable ntfy forwarding.
# F4 opens the ntfy snooze menu (1/2/4/8/12/24h + Resume now). Snooze expiry is
# persisted beside the token cache and therefore survives restarts.

# Seconds an unread Outlook message must remain open before it is marked read.
# Default: 0 (mark read immediately after the message body is displayed).
# M365_READ_MSG_TIMEOUT=0

# Enable native Out of Office management through /ooo, /ooo set and /ooo clear.
# With default scopes this adds delegated MailboxSettings.ReadWrite.
# If M365_SCOPES is set explicitly, add MailboxSettings.ReadWrite there yourself.
# OOO date/time input uses the machine-configured local time zone and validates
# DST gaps/overlaps before storing the schedule as unambiguous UTC in Graph.
# M365_OUT_OF_OFFICE=1

# EXPERIMENTAL / UNTESTED: load richer internal Teams contact profiles directly
# from the Entra directory via /users/{GUID}. This can expose business/mobile
# phones, job title, department, office and company when the tenant provides them.
# Adds delegated User.Read.All when default scopes are used. User.Read.All requires
# administrator consent. If M365_SCOPES is set explicitly, add User.Read.All there.
# Leave disabled unless you intentionally want to test this path.
# M365_DIRECTORY_PROFILE=1

# Opt in to Teams *channels* (adds the Team.ReadBasic.All scope, needed to list
# the teams you belong to). Chats work without it. Same consent caveat as below.
# M365_TEAMS_CHANNELS=1

# Show regular Teams image file attachments (PNG/JPEG/GIF) through Kitty.
# Adds the delegated Files.Read.All scope when default scopes are used.
# If M365_SCOPES is set explicitly, include Files.Read.All there yourself.
# M365_TEAMS_FILE_IMAGES=1

# Optional common root for persistent application cache/state.
# Preferred:
# M365_CACHE_DIR=/home/user/.cache/m365-tui
#
# Backward-compatible fallback (deprecated):
# M365_TEAMS_IMAGE_CACHE_DIR=/home/user/.cache/m365-tui
#
# Resolution order:
#   1. M365_CACHE_DIR
#   2. M365_TEAMS_IMAGE_CACHE_DIR
#   3. neither -> no persistent Teams/UI cache
#
# If both variables are set, M365_CACHE_DIR wins. Deprecated usage is reported
# only after the TUI has exited. No configuration or cache directories are
# migrated automatically when switching variable names.
#
# The root is private on Unix; image thumbnails, conversation JSON, UI state and
# Stay archived ids are stored below it. Conversation data is plaintext and is
# not encrypted. The authentication token cache is separate (M365_TOKEN_CACHE).
#
# Shared limit for evictable cache data: Teams images + conversation JSON.
# UI state and Stay archived state are not counted and are never pruned.
# M365_CACHE_MAX_MB=256
# Deprecated fallback; M365_CACHE_MAX_MB wins when both are set:
# M365_TEAMS_IMAGE_CACHE_MAX_MB=256
#
# Markdown-style formatting for outgoing Teams chat/channel messages is enabled
# by default. Set to 0/false/no/off to send literal plain text instead.
# M365_TEAMS_MARKDOWN=0

# Teams system-event visibility.
# useful = useful + unknown events, known low-value noise hidden (default)
# all    = all known and unknown system events
# none   = hide all system events
# M365_TEAMS_SYSTEM_EVENTS=useful

# Automatically prefill persistent Teams chat caches in the background.
# Enabled by default when M365_CACHE_DIR (or its deprecated fallback) is configured.
# Large tenants can disable this Graph warm-up while keeping cache-on-open and
# local cached previews for chats that were already cached.
# M365_TEAMS_CACHE_WARMUP=0

# Dynamic polling for recently-active Teams chats.
# M365_TEAMS_HOT_CHATS is one shared top-N limit for all accelerated
# HOT/WARM/COOL chats, despite the historical variable name:
#   HOT    <= 2 minutes  target 2s
#   WARM   <= 5 minutes  target 5s
#   COOL   <= 15 minutes target 10s
#   NORMAL > 15 minutes  normal 20s application refresh
#
# Defaults: 6 chats and 6 requests/s. M365_TEAMS_HOT_CHATS accepts 1-16.
# M365_TEAMS_POLL_BUDGET_RPS accepts 0.5-8 rps. The budget is also shared by
# Teams unread-count and cold-cache warm-up message GETs. Invalid combinations
# whose full-load effective interval would exceed 5s are rejected. After Graph
# throttling the runtime budget may temporarily fall below the configured value
# and then recover automatically.
# M365_TEAMS_HOT_CHATS=6
# M365_TEAMS_POLL_BUDGET_RPS=6

# Calendar reminders 15 and 5 minutes before timed events.
# all      = internal TUI + desktop notification (default)
# internal = internal non-blocking TUI notification only
# external = desktop notification only
# none     = disable Calendar reminders completely
# Desktop delivery also respects M365_NOTIFY.
# M365_CALENDAR_NOTIFY=all

# Optional executable for all web links opened by m365-tui, including
# message links, Calendar online meetings, and Outlook Web settings.
# Leave unset to use the system handler (xdg-open on Linux, open on macOS).
# The URL is passed directly as one argument; no shell is involved.
# M365_WEBLINK_OPENER=/usr/bin/firefox
#
# Deprecated compatibility fallback. M365_WEBLINK_OPENER wins when both are set.
# M365_MEETING_OPENER=/usr/bin/firefox

# Opt in to *setting* your own presence (adds the Presence.ReadWrite scope).
# Off by default: adding a scope invalidates existing consent, so in tenants that
# require admin approval every sign-in would need re-approval. Enable only after
# Presence.ReadWrite is added to the app registration and consented.
# M365_PRESENCE_WRITE=1
#
# The same permission enables Teams status-message editing from the `p` menu:
# `m` sets/edits the message, `c` clears it (`x` is an alias), and `a` clears
# manual preferred presence and returns to automatic presence.
#
# The same permission also enables Teams status-message editing from the `p`
# menu: `m` sets/edits the message, `c` clears it (`x` is an alias), and `a`
# clears manual preferred presence and returns to automatic presence.

# Keep an application presence session active while m365-tui is running.
# This makes m365-tui behave as an active Teams presence client without
# setting a sticky user-preferred status. Implies Presence.ReadWrite when
# M365_SCOPES is not explicitly overridden.
# M365_PRESENCE_PRIMARY=1

# Minutes of effective local inactivity before the primary presence session
# is temporarily overridden to Away. The pre-idle application-session state is
# restored after confirmed activity. With the default activity source this uses
# desktop input on X11, a conservative logind fallback on Wayland, plus direct
# key/paste activity inside m365-tui. Default: 5 minutes. Set to 0 to disable
# inactivity-driven Away; screen lock still temporarily publishes Away.
# M365_PRESENCE_AVAILABLE_TIMEOUT_MIN=5

# Activity backend for automatic primary presence.
# auto (default): X11 XScreenSaver on X11; Wayland ext-idle-notify prototype
# with logind fallback on Wayland; app-local fallback if desktop detection fails.
# Screen lock temporarily publishes Away. After unlock, confirmed activity
# restores the pre-lock app session; Graph calendar/call/OOO/manual presence
# precedence remains authoritative.
# Other values: desktop, x11, wayland, logind, app.
# M365_PRESENCE_ACTIVITY_SOURCE=auto

# Restoring the application presence that was active before a screen lock is
# enabled by default. While locked, m365-tui publishes Away for its own session.
# After unlock and confirmed user activity it restores the saved app presence;
# if nothing was saved it uses the normal automatic default. Graph may still
# show a higher-priority calendar/call/manual presence. Set to 0 to disable
# saving/restoring the pre-lock app presence.
# M365_PRESENCE_LOCK_RESTORE=0

# Show presence/status for contacts in one-to-one Teams chats. Presence.Read.All
# is already part of the default scopes; this flag only enables the UI feature.
# M365_PRESENCE_READ=1

# ── Real-time (optional; leave M365_TUNNEL_BASE_URL empty for poll-only) ──────
# Public HTTPS base that Cloudflare routes to the webhook, e.g.
# https://m365.example.com  (NO trailing slash, NO path).
M365_TUNNEL_BASE_URL=

# Shared secret echoed in subscription clientState and verified by the webhook.
# Generate one: `uuidgen` or `openssl rand -hex 16`. MUST match on both sides.
M365_CLIENT_STATE=

# Redis URL the TUI connects to (the webhook uses redis://redis:6379 internally).
M365_REDIS_URL=redis://127.0.0.1:6379

# Cloudflare named-tunnel token (from the Zero Trust dashboard). Used by the
# cloudflared container only.
CLOUDFLARE_TUNNEL_TOKEN=

# Opt in to directory search when starting a Teams chat (User.ReadBasic.All).
# M365_PEOPLE_SEARCH=1
